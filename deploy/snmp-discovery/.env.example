# Runtime credentials; replace before enabling device policies and Diode.
DIODE_TARGET=grpc://diode.example:8080/diode
DIODE_CLIENT_ID=replace-me
DIODE_CLIENT_SECRET=replace-me
SNMP_COMMUNITY=replace-me

# Target platform. Use linux/arm64 for ARM64 hosts or native Apple Silicon.
ORB_PLATFORM=linux/amd64
# The official base image digest and source commit are fixed in compose.yaml
# and image.lock.json; existing ORB_BASE_IMAGE/ORB_BUILD_COMMIT env vars are unused.
